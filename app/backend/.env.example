# ─── Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development # production

# ─── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/clearpath
REDIS_URL=redis://localhost:6379

# ─── JWT / Token Settings ─────────────────────────────────
# Short access token lifetime (15m, 1h, etc.)
ACCESS_TOKEN_EXPIRY=15m
# Refresh token lifetime in full days
REFRESH_TOKEN_EXPIRY_DAYS=7

#supabase config
SUPABASE_URL=https://your-project.supabase.co

SUPABASE_PUBLISHABLE_KEY=sb_publishable_

SUPABASE_SECRET_KEY=sb_secret_


# ─── Database (raw pg pool) ───────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Use the "Session" pooler (port 5432) or "Transaction" pooler (port 6543).
# For the outbox dispatcher LISTEN/NOTIFY, use Session pooler (port 5432).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Pipeline ─────────────────────────────────────────────────────────────────
ANALYSIS_QUEUE_NAME=document-analysis
ANALYSIS_JOB_ATTEMPTS=5
ANALYSIS_VERSION=v1

# Isolated queue for the Stage-2 (OCR/extraction) job, consumed only by
# the Python ocr-engine service (see services/ocr-engine/.env.example -
# its BULLMQ_QUEUE_NAME must match this value). Deliberately separate
# from ANALYSIS_QUEUE_NAME so Node and Python are never competing
# consumers on the same queue.
OCR_QUEUE_NAME=document-ocr
OCR_JOB_ATTEMPTS=5

# Worker identity - unique per process/container for multi-worker setups
WORKER_ID=worker-1

# @xenova/transformers model cache directory
TRANSFORMERS_CACHE=/var/cache/transformers

# ─── Outbox dispatcher ────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_RETRIES=10

# ─── SSE ──────────────────────────────────────────────────────────────────────
SSE_HEARTBEAT_INTERVAL_MS=15000

# ─── Internal endpoints ───────────────────────────────────────────────────────
INTERNAL_API_KEY=your-strong-random-internal-key


# Groq Setup
GROQ_API_KEY=gsk_
GROQ_MODEL=

TAVILY_API_KEY=

# ─── AI Pipeline Selection ────────────────────────────────────────────────────
# Two AI pipelines ship today:
#   * "classic" — fixed 5-stage orchestrator (Understanding → Extraction →
#     Verification → Synthesis → Safety). Deterministic, well-tested default.
#   * "agentic" — model picks its own trajectory using tools (read chunks, search
#     the web, extract candidates, verify, finalize). Faster on short docs,
#     richer tool use on long/complex docs.
#
# AGENTIC_PIPELINE_ENABLED — global kill-switch for the agentic pipeline.
#   When "false", every analysis is forced to classic regardless of the
#   `?pipeline=` query param. Defaults to true (opt-out).
AGENTIC_PIPELINE_ENABLED=true

# AGENTIC_PIPELINE_DEFAULT — pipeline used when the client does NOT supply
#   `?pipeline=` on POST /analysis/documents/:id/analyze. Clients can still
#   override per request with `?pipeline=agentic` or `?pipeline=classic`
#   (when AGENTIC_PIPELINE_ENABLED is true). Defaults to "classic".
AGENTIC_PIPELINE_DEFAULT=classic
