# ==============================================================================
# REQUIRED SETTINGS (App will fail to start if these are missing)
# ==============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ==============================================================================
# OPTIONAL SETTINGS (Defaults from config.py will be used if omitted)
# ==============================================================================

# Threading Limits
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2

# Redis Configuration
# If REDIS_URL is set, it takes precedence (e.g., redis://:password@localhost:6379/0)
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# BullMQ Configuration
# ISOLATED queue - must match the Node backend's OCR_QUEUE_NAME
# (default "document-ocr"). This service is the ONLY consumer of this
# queue; the Node worker never connects to it.
# Alternative alias supported: OCR_QUEUE_NAME
BULLMQ_QUEUE_NAME=document-ocr

BULLMQ_JOB_NAME=extract-layout-and-ocr

BULLMQ_CONCURRENCY=2

# Storage buckets
# RAW_BUCKET must match where the Node backend uploads originals to
# (see app/backend/src/workers/stages/extractionStage.ts).
RAW_BUCKET=documents
PARSED_BUCKET=parsed-documents

HF_TOKEN=